---
import Layout from '../layouts/default.astro';

// Page metadata
const pageTitle = 'Home | Heromes Website';
const pageDescription = 'Welcome to our website - We provide excellent digital services.';
---

<Layout title={pageTitle} description={pageDescription}>
  <main>
    <section class="hero">
      <h1>Welcome to Heromes</h1>
      <p>{ pageDescription }</p>
    </section>
    
    <section class="features">
      <h2>What we do</h2>
      <ul>
        <li>Web Development</li>
        <li>Consulting</li>
        <li>Support Services</li>
      </ul>
    </section>

    <a href="/services">View our services →</a>
  </main>
</Layout>